{
  "name": "storydesk-public",
  "productName": "创作协作台开源版",
  "version": "2.0.14-beta.3",
  "private": true,
  "description": "本地文档优先的小说资料、正文与剧情归档工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "package": "npm run prepare:runtime && npm run build && electron-builder --win --x64 --dir",
    "installer": "npm run prepare:runtime && npm run build && electron-builder --win nsis --x64",
    "test:reader": "node scripts/reader-layout-desktop-smoke.mjs",
    "test:memory": "node scripts/memlayer-desktop-smoke.mjs",
    "test:connections": "node scripts/public-connection-smoke.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "installer:signed": "npm run prepare:runtime && npm run build && electron-builder --win nsis --x64 -c.win.signExecutable=true -c.forceCodeSigning=true -c.directories.output=release-signed"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.15",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@lezer/highlight": "1.2.5",
    "@uiw/react-codemirror": "^4.25.0",
    "cytoscape": "^3.33.1",
    "dompurify": "^3.2.7",
    "markdown-it": "^14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.4.1",
    "electron-builder": "latest",
    "playwright-core": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "local.storydesk.public",
    "productName": "创作协作台开源版",
    "directories": {
      "output": "release-public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json",
      "assets/**/*",
      "!**/*.bak-*",
      "LICENSE",
      "NOTICE"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/workbench-mark.ico",
      "signExecutable": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "signExts": [
        "!python.exe",
        "!pythonw.exe"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "创作协作台（开源版）"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true
    },
    "artifactName": "StoryDesk-${version}-win-${arch}.${ext}",
    "extraResources": [
      {
        "from": "vendor/memlayer",
        "to": "memlayer",
        "filter": [
          "*.py",
          "LICENSE",
          "NOTICE.upstream.txt"
        ]
      },
      {
        "from": ".build-runtime/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*.md"
        ]
      }
    ]
  },
  "author": "chilayt",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chilayt/storydesk.git"
  }
}
